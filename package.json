{
  "name": "@vergil-astro/vergil-cli",
  "version": "0.2.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "CLI toolkit for Vergil Astro theme — write, publish, and manage your blog",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "vg": "bin/vg"
  },
  "files": [
    "bin/",
    "dist/",
    "tools/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "lint": "eslint src/",
    "test": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "vergil",
    "astro",
    "blog",
    "cli",
    "content-management",
    "markdown",
    "writing"
  ],
  "author": "Rosh <dogegotout@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "chalk": "^6.0.1",
    "commander": "^15.0.0",
    "gray-matter": "^4.0.3",
    "inquirer": "^14.2.5",
    "ora": "^10.0.0",
    "remark": "^15.0.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "unist-util-visit": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vergil-astro/vergil-cli.git"
  },
  "bugs": {
    "url": "https://github.com/vergil-astro/vergil-cli/issues"
  },
  "homepage": "https://github.com/vergil-astro/vergil-cli#readme"
}
